@ECHO OFF
CLS

IF EXIST ..\OBJ\GEMAS.OBJ DEL ..\OBJ\GEMAS.OBJ
IF EXIST ..\BIN\GEMAS.EXE DEL ..\BIN\GEMAS.EXE
IF EXIST ..\BIN\GEMAS.MAP DEL ..\BIN\GEMAS.MAP

CD \SRC

ECHO CRYSTAL QUEST

ECHO Compilando GEMAS.ASM...
\TOOLS\TASM GEMAS.ASM, ..\OBJ\GEMAS.OBJ

IF ERRORLEVEL 1 GOTO ERROR

ECHO Enlazando el programa...
\TOOLS\TLINK ..\OBJ\GEMAS.OBJ, ..\BIN\GEMAS.EXE, ..\BIN\GEMAS.MAP

IF ERRORLEVEL 1 GOTO ERROR

ECHO Compilacion exitosa.
GOTO FIN

:ERROR

ECHO Error durante la compilacion o el enlazado.

:FIN

PAUSE